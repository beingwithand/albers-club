{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(which *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(fd *)",
      "Bash(find *)",
      "Bash(jq *)",
      "Bash(diff *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(date)",
      "Bash(date *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git log)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --list *)",
      "Bash(git remote -v)",
      "Bash(git rev-parse *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(python3 --version)",
      "Bash(node --version)",
      "Bash(claude --version)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git branch -D *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(gh secret *)",
      "Bash(npm publish *)",
      "Bash(sudo *)",
      "Bash(op *)",
      "Bash(pmset *)",
      "Bash(launchctl *)",
      "Bash(defaults write *)",
      "Bash(crontab *)",
      "Bash(osascript *)",
      "WebFetch"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME/*)",
      "Bash(rm -rf __HOME__)",
      "Bash(rm -rf __HOME__/*)",
      "Bash(rm -fr *)",
      "Bash(sudo rm *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push --mirror *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit * --visibility *)",
      "Bash(gh auth token *)",
      "Bash(gh auth token)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(curl * | zsh)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Bash(sh)",
      "Bash(bash)",
      "Bash(zsh)",
      "Bash(diskutil erase*)",
      "Bash(diskutil eraseDisk *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(chmod -R 777 *)",
      "Bash(tmutil delete *)",
      "Bash(fdesetup disable *)",
      "Bash(csrutil *)",
      "Bash(security find-generic-password *)",
      "Bash(security find-internet-password *)",
      "Bash(security dump-keychain *)",
      "Bash(op item get * --reveal *)",
      "Bash(cat ~/.ssh/*)",
      "Bash(cat ~/.aws/*)",
      "Bash(cat .env)",
      "Bash(cat .env.*)",
      "Bash(cat */.env)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.config/op/**)",
      "Read(~/.op/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Group Containers/2BUA8C4S2C.com.1password/**)",
      "Read(~/Library/Application Support/1Password/**)",
      "Read(~/Library/Application Support/Bitwarden/**)",
      "Read(~/.password-store/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/secrets/**)",
      "Edit(/evals/**)",
      "Edit(**/evals/**)",
      "Write(/evals/**)",
      "Write(**/evals/**)",
      "Edit(/rubrics/**)",
      "Edit(**/rubrics/**)",
      "Write(/rubrics/**)",
      "Write(**/rubrics/**)",
      "Edit(~/.claude/settings.json)",
      "Write(~/.claude/settings.json)",
      "Read(~/.config/gh/**)",
      "Bash(git commit --no-verify *)",
      "Bash(git push --no-verify *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "codeload.github.com",
        "ghcr.io",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "formulae.brew.sh",
        "*.supabase.co"
      ]
    }
  },
  "env": {
    "HARNESS_DATA": "__HOME__/harness-data",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2"
  },
  "enableAllProjectMcpServers": false,
  "cleanupPeriodDays": 365,
  "autoMemoryEnabled": true,
  "effortLevel": "high",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Code needs your attention\" with title \"Claude Code\" sound name \"Glass\"'"
          }
        ]
      }
    ]
  }
}
